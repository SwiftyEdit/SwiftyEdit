{
  "name": "swiftyedit/swiftyedit",
  "type": "project",
  "description": "SwiftyEdit is a Web Content Management System for Websites, Blogs and Shops",
  "homepage": "https://swiftyedit.dev",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "SwiftyEdit Developer",
      "role": "Developer",
      "homepage": "https://github.com/SwiftyEdit/SwiftyEdit"
    }
  ],
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.3"
    },
    "vendor-dir": "vendor"
  },
  "require": {
    "ext-pdo": "*",
    "catfan/medoo": "^2.1.12",
    "enshrined/svg-sanitize": "^1.0",
    "erusev/parsedown": "^1.8",
    "erusev/parsedown-extra": "^0.9",
    "ezyang/htmlpurifier": "^4.18.0",
    "league/iso3166": "^4.4.0",
    "phpmailer/phpmailer": "^6.10.0",
    "smarty/smarty": "^5.8.5",
    "symfony/yaml": "^7.4",
    "twig/twig": "^3.30.0"
  },
  "scripts": {
    "buildclean": "rm -rf dist && rm -f ./dist/*.zip",
    "buildprepare": "bash build_prepare.sh",
    "build": [
      "@buildclean",
      "@buildprepare"
    ],
    "outdated:direct": "composer outdated --direct",
    "check": [
      "@composer audit",
      "@composer validate --strict"
    ],
    "analyse": "phpstan analyse --memory-limit=1G",
    "analyse:baseline": "phpstan analyse --memory-limit=1G --generate-baseline --allow-empty-baseline",
    "analyse:count": "PHPSTAN_NO_BASELINE=1 phpstan analyse --memory-limit=1G --no-progress --error-format=json | php phpstan-count.php"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3"
  }
}
