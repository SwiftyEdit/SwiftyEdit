# PHPStan configuration for SwiftyEdit
# Run with: composer analyse
#
# The baseline (phpstan-baseline.neon) is local only and not tracked in git.
# Create or refresh it with: composer analyse:baseline

includes:
    - phpstan-baseline-loader.php

parameters:
    level: 5
    phpVersion: 80300
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Medoo's class docblock has IDE-only @method overloads (e.g. select()
    # with 4 required parameters); its own stub replaces them for PHPStan
    stubFiles:
        - vendor/catfan/medoo/phpstan/Medoo.stub
    dynamicConstantNames:
        - SE_INCLUDE_PATH
        - DB_PREFIX
    paths:
        - config.php
        - acp
        - app
        - install
        - public/admin.php
        - public/admin_xhr.php
        - public/dispatch.php
        - public/index.php
        - public/install.php
        - public/rss.php
        - public/assets/themes/default/php
        - plugins/ace-editor
        - plugins/se_cash-pay
        - plugins/se_invoice-pay
        - plugins/se_paypal-pay
        - plugins/tinymce-editor
    excludePaths:
        - */node_modules/*
