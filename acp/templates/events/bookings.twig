{# guestlist confirmations of the events in /admin/events/bookings/, rendered by bookings.php #}
{% extends 'layout/module-overview.twig' %}

{% block list %}
    {# keep opened events open when the list is reloaded (e.g. after deleting a confirmation) #}
    <div id="getBookings" hx-get="{{ reader_uri }}?action=list_bookings" hx-trigger="load, {{ list_triggers }}"
         hx-on::before-swap="this.dataset.open = [...this.querySelectorAll('.collapse.show')].map(e => e.id).join(',')"
         hx-on::after-settle="(this.dataset.open || '').split(',').filter(Boolean).forEach(id => {
             document.getElementById(id)?.classList.add('show');
             this.querySelector('[data-bs-target=\'#' + id + '\']')?.setAttribute('aria-expanded', 'true');
         })"></div>
{% endblock %}

{% block sidebar %}
    {% include 'events/past-events-toggle.twig' %}
{% endblock %}
