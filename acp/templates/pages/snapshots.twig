{#
 # older versions of a page below the edit form, loaded by the pages data-reader (?snapshots=id)
 # snapshots: list of {id, lastedit, title, lastedit_from} - id is the row in se_pages_cache
 #}
<div class="card my-3">
    <div class="accordion accordion-flush" id="accordionVersions">
        <div class="accordion-item">
            <div class="accordion-header" id="headingVersions">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVersions" aria-expanded="false" aria-controls="collapseVersions">Versions ({{ snapshots|length }})</button>
            </div>
            <div id="collapseVersions" class="accordion-collapse collapse" aria-labelledby="headingVersions" data-bs-parent="#accordionVersions">
                <div class="accordion-body">
                    <div class="scroll-container">
                        <table class="table table-hover">
                            {% for snapshot in snapshots %}
                                <tr>
                                    <td>{{ snapshot.lastedit }}</td>
                                    <td>{{ snapshot.title }}</td>
                                    <td>{{ snapshot.lastedit_from }}</td>
                                    <td>
                                        <form action="/admin/pages/edit/" method="POST">
                                            <button class="btn btn-sm btn-default w-100" name="restore_id" value="{{ snapshot.id }}" title="{{ lang.edit }}">{{ icon.edit|raw }} {{ lang.edit }}</button>
                                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
