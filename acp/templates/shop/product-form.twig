{#
 # product form in /admin/shop/edit/, /new/ and /duplicate/, rendered by products-edit.php
 # product holds the decoded text fields, everything ending in _options is a list of
 # {value, label, selected} for the select() macro
 #}

{% macro select(name, options, id = null, class = 'form-control custom-select') %}
    <select name="{{ name }}" class="{{ class }}"{% if id %} id="{{ id }}"{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{# drop zone for related products, accessories and addons, filled by the product-select widget #}
{% macro product_dropper(id, picker_index, items) %}
    <div id="{{ id }}" class="sortable_target target_products list-group mb-3" data-picker-index="{{ picker_index }}">
        {% for item in items %}
            <div class="list-group-item draggable" data-id="{{ item.id }}">
                <div class="d-flex flex-row gap-2">
                    <div class="text-muted small"><img src="{{ item.flag }}" width="15"> {{ item.title }}[#{{ item.id }}] {{ item.number }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{% import _self as m %}

<div class="subHeader"></div>
<div id="formResponse"></div>
<form class="no-enter">
    <div class="row">
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" id="bsTabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#intro">{{ lang.nav_btn_intro }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#content">{{ lang.nav_btn_descriptions }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#prices_delivery">{{ lang.nav_btn_prices_delivery }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#features">{{ lang.nav_btn_features }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#seo">{{ lang.nav_btn_seo }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#links" title="{{ lang.nav_btn_links }}"><i class="bi bi-link"></i></a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#downloads" title="{{ lang.nav_btn_downloads }}"><i class="bi bi-download"></i></a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#filter" title="Filter"><i class="bi bi-filter"></i></a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#addons" title="{{ lang.nav_btn_addons }}"><i class="bi bi-plugin"></i></a></li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">

