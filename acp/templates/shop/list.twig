{# overview of the products in /admin/shop/, rendered by products-list.php #}
{% extends 'layout/module-overview.twig' %}

{% block list %}
    {# data-keep-open: opened variant lists stay open when the list reloads #}
    <div id="getProducts" data-keep-open hx-get="{{ reader_uri }}?action=list_products" hx-trigger="load, {{ list_triggers }}"></div>
{% endblock %}

{% block sidebar %}
    {% import 'components/form/macros.twig' as form %}
    <div class="card mb-2">
        <div class="card-body">
            <div class="row">
                <div class="col-8">
                    <form hx-post="{{ writer_uri }}" hx-swap="none" hx-trigger="change">
                        <label class="form-label" for="sorting_products">{{ lang.sorting }}</label>
                        {{ form.select('sorting_products', sorting_options, 'sorting_products') }}
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    </form>
                </div>
                <div class="col-4">
                    <label class="form-label">&nbsp;</label>
                    <div class="btn-group d-flex">
                        {% for direction, direction_icon in {'ASC': icon.arrow_up, 'DESC': icon.arrow_down} %}
                            <button hx-post="{{ writer_uri }}" hx-include="[name='csrf_token']" hx-swap="none" name="sorting_products_dir" value="{{ direction }}" title="{{ direction == 'ASC' ? lang.btn_sort_asc : lang.btn_sort_desc }}" class="btn btn-default w-100">{{ direction_icon|raw }}</button>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="accordion mb-2" id="accordionSidebar">
        <div class="accordion-item">
            <div class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCategories" aria-expanded="false" aria-controls="collapseCategories">{{ lang.label_categories }}</button>
            </div>
            <div id="collapseCategories" class="accordion-collapse collapse" data-bs-parent="#accordionSidebar">
                <div class="accordion-body p-0">
                    <div class="scroll-container p-0">
                        <div hx-get="{{ reader_uri }}?action=list_categories" hx-trigger="load, {{ list_triggers }}"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <div class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseKeys" aria-expanded="false" aria-controls="collapseKeys">{{ lang.label_keywords }}</button>
            </div>
            <div id="collapseKeys" class="accordion-collapse collapse" data-bs-parent="#accordionSidebar">
                <div class="accordion-body p-0">
                    <div hx-get="{{ reader_uri }}?action=list_keyword_btn" hx-trigger="load, {{ list_triggers }}"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header">Checks</div>
        <div class="list-group list-group-flush">
            <div hx-get="{{ reader_uri }}?action=check_missing_sku" hx-trigger="load"></div>
            <div hx-get="{{ reader_uri }}?action=check_double_slugs" hx-trigger="load"></div>
        </div>
    </div>

    <div class="card mb-2">
        <div class="card-header">Cache</div>
        <div class="list-group list-group-flush">
            <button hx-post="{{ writer_uri }}" hx-target="#cacheDeleteResponse" hx-include="[name='csrf_token']" hx-indicator=".htmx-indicator" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" name="products_cache" value="clear" title="{{ lang.btn_clear_cache }}">
                <span>{{ icon.trash|raw }} {{ lang.btn_delete_cache }}</span>
                <span id="cacheDeleteResponse"></span>
            </button>
            <button hx-post="{{ writer_uri }}" hx-target="#cacheUpdateResponse" hx-include="[name='csrf_token']" hx-indicator=".htmx-indicator" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" name="products_cache" value="update" title="{{ lang.btn_clear_cache }}">
                <span>{{ icon.arrow_clockwise|raw }} {{ lang.btn_update }}</span>
                <span id="cacheUpdateResponse"></span>
            </button>
        </div>
    </div>
{% endblock %}
