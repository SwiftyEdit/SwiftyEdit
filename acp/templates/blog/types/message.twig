{# post type "m" - message #}
{% extends 'blog/post-form.twig' %}
{% import 'blog/macros.twig' as blog %}
{% import 'components/form/macros.twig' as form %}

{% block nav %}
    <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#intro">{{ lang.nav_btn_intro }}</a></li>
    <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#content">{{ lang.nav_btn_content }}</a></li>
{% endblock %}

{% block panes %}
    <div class="tab-pane fade show active" id="intro">
        <div class="row">
            <div class="col-md-6">
                {{ blog.title(post) }}
                {{ inputs.teaser|raw }}
            </div>
            <div class="col-md-6">
                {{ form.images(images) }}
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="content">
        {{ inputs.text|raw }}
    </div>
{% endblock %}
