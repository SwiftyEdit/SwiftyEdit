{#
 # base form for blog posts in /admin/blog/edit/ and /new/, rendered by blog-edit.php
 # every post type (blog/types/*.twig) extends it and fills the blocks
 #   nav    - its own tabs, the first one is the active one
 #   panes  - the matching tab panes
 #   source - the "source" input, video and link posts have none
 #   after_form - markup outside the form, e.g. the gallery upload modal
 #
 # all inputs are submitted, missing ones are stored empty (see the blog data-writer)
 #}

{% import 'components/form/macros.twig' as form %}

<form>
    <div class="row">
        <div class="col-md-9">
            <div class="card">
                <div class="card-header">
                    <ul class="nav nav-tabs card-header-tabs" id="bsTabs" role="tablist">
                        {% block nav %}{% endblock %}
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#meta">{{ lang.nav_btn_seo }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#prefs">{{ lang.nav_btn_settings }}</a></li>
                        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#addons" title="{{ lang.nav_btn_addons }}">{{ icon.plugin|raw }}</a></li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">

                        {% block panes %}{% endblock %}

                        <div class="tab-pane fade" id="meta">
                            <div class="mb-3">
                                <label class="form-label">{{ lang.label_title }}</label>
                                <input class="form-control" name="post_meta_title" type="text" value="{{ post.post_meta_title }}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ lang.label_description }}</label>
                                <textarea class="form-control count-chars" rows="4" name="post_meta_description">{{ post.post_meta_description }}</textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">{{ lang.label_keywords }}</label>
                                <input type="text" class="form-control tags" name="post_tags" value="{{ post.post_tags }}">
                            </div>

                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-2">
                                        <label class="form-label">{{ lang.label_pages_permalink }}</label>
                                        <input type="text" id="disabledTextInput" class="form-control" value="{{ se_base_url }}" disabled>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-2">
                                        <label class="form-label">{{ lang.label_main_category_page }}</label>
                                        {{ form.select('main_category_slug', main_category_options, null, 'custom-select form-control') }}
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-2">
                                        <label class="form-label">{{ lang.label_slug }}</label>
                                        <input class="form-control" name="post_slug" type="text" value="{{ post.post_slug }}">
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Canonical URL {{ canonical_docs_link|raw }}</label>
                                <input class="form-control" name="post_canonical_url" type="text" value="{{ post.post_canonical_url }}">
                            </div>
                        </div> <!-- #meta -->

                        <div class="tab-pane fade" id="prefs">
                            <div class="mb-3">
                                <label class="form-label">{{ lang.label_author }}</label>
                                <input class="form-control" name="post_author" type="text" value="{{ post.post_author }}">
                            </div>
                            {% block source %}
                                <div class="mb-3">
                                    <label class="form-label">{{ lang.label_source }}</label>
                                    <input class="form-control" name="post_source" type="text" value="{{ post.post_source }}">
                                </div>
                            {% endblock %}
                            <h5 class="heading-line">RSS</h5>
                            <div class="mb-3">
                                {{ inputs.rss|raw }}
                            </div>
                            <div class="mb-3">
                                <label for="inputRssUrl" class="form-label">{{ lang.label_rss_url }}</label>
                                <input id="inputRssUrl" class="form-control" name="post_rss_url" type="text" value="{{ post.post_rss_url }}">
                            </div>
                        </div> <!-- #prefs -->

                        <div class="tab-pane fade" id="addons">
                            {{ addon_module_forms|raw }}
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <div class="sidebar-actions sticky-lg-top">
                    <button type="submit" hx-post="/admin-xhr/blog/write/" hx-trigger="click" hx-target="#formResponse" hx-swap="innerHTML" class="btn btn-success w-100" name="save_post" value="{{ mode == 'new' ? 'save' : 'update' }}">{{ mode == 'new' ? lang.save : lang.update }}</button>
                </div>
                <div class="mb-1 pb-1 border-bottom">
                    {{ inputs.language|raw }}
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    <label>{{ lang.label_categories }}</label>
                    <div class="scroll-container" style="max-height: 150px;">
                        {{ form.categories('post_categories[]', categories) }}
                    </div>
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    <label>{{ lang.label_tags }}</label>
                    <input type="text" class="form-control tags" name="content_tags" value="{{ content_tags }}">
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    <label>{{ lang.label_releasedate }}</label>
                    <input class="dp form-control" name="post_releasedate" type="datetime-local" value="{{ releasedate }}">
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    {{ inputs.hide_detail_page|raw }}
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    <label>{{ lang.label_priority }}</label>
                    <input type="number" name="post_priority" value="{{ post.post_priority }}" class="form-control">
                    <div class="form-check">
                        <input class="form-check-input" id="fix" type="checkbox" name="post_fixed" value="fixed"{% if post.post_fixed == '1' %} checked{% endif %}>
                        <label class="form-check-label" for="fix">{{ lang.label_fixed }}</label>
                    </div>
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    {{ inputs.status|raw }}
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    {{ inputs.comments|raw }}
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    {{ inputs.votings|raw }}
                </div>
                <div class="mb-2 pb-1 border-bottom">
                    <label>{{ lang.labels }}</label>
                    <div>{{ form.labels('post_labels[]', labels) }}</div>
                </div>

                <input name="post_type" type="hidden" value="{{ post_type }}">
                <input name="post_id" type="hidden" value="{{ post.post_id }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="post_date" value="{{ post.post_date }}">
            </div>
        </div>
    </div>
</form>

{% block after_form %}{% endblock %}
