{#
 # pieces used by several post types (blog/types/*.twig)
 #}

{% macro title(post) %}
    <div class="mb-3">
        <label class="form-label">{{ lang.label_title }}</label>
        <input class="form-control" name="post_title" type="text" value="{{ post.post_title }}">
    </div>
{% endmacro %}
