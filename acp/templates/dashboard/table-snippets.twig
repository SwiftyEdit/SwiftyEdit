<div class="list-group list-group-flush">
    {% for snippet in get_snippets %}
        <button type="submit" form="snippetsEditForm" class="list-group-item list-group-item-action" name="snippet_id" value="{{ snippet.snippet_id }}">
            <span class="dash-row-title">
                <span class="dash-row-tag">{{ snippet.snippet_name }}</span>
                {{ snippet.snippet_title }}
            </span>
            <span class="dash-row-meta">{{ snippet.snippet_se_format_datetime }}</span>
        </button>
    {% endfor %}
</div>
<form id="snippetsEditForm" action="/admin/snippets/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
