<div class="list-group list-group-flush">
    {% for event in get_events %}
        <button type="submit" form="eventsEditForm" class="list-group-item list-group-item-action" name="id" value="{{ event.id }}">
            <span class="dash-row-title">{{ event.title }}</span>
            <span class="dash-row-meta">{{ event.lastedit_formatted }}</span>
        </button>
    {% endfor %}
</div>
<form id="eventsEditForm" action="/admin/events/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
