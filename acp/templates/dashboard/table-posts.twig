<div class="list-group list-group-flush">
    {% for post in get_posts %}
        <button type="submit" form="postsEditForm" class="list-group-item list-group-item-action" name="post_id" value="{{ post.post_id }}">
            <span class="dash-row-title">{{ post.post_title }}</span>
            <span class="dash-row-meta">{{ post.post_lastedit_formatted }}</span>
        </button>
    {% endfor %}
</div>
<form id="postsEditForm" action="/admin/blog/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
