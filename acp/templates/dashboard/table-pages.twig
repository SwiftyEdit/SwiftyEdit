<div class="list-group list-group-flush">
    {% for page in getPages %}
        <button type="submit" form="pagesEditForm" class="list-group-item list-group-item-action" name="page_id" value="{{ page.page_id }}">
            <span class="dash-row-title">{{ page.page_title }}</span>
            <span class="dash-row-meta">{{ page.page_se_format_datetime }}</span>
        </button>
    {% endfor %}
</div>
<form id="pagesEditForm" action="/admin/pages/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
