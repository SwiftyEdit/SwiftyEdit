{#
 # Plugins, rendered by the dashboard data-reader (action=list_addons)
 #}
<div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="{{ lang.nav_btn_addons }}" hx-target="#getAddons" hx-swap="innerHTML">
    <button class="chip{{ filter == 'usable' ? ' active' : '' }}" aria-pressed="{{ filter == 'usable' ? 'true' : 'false' }}"
            hx-get="{{ reader_uri }}?action=list_addons&filter=usable">{{ lang.api_keys_active }} <span class="chip-count">{{ count_usable }}</span></button>
    <button class="chip{{ filter == 'all' ? ' active' : '' }}" aria-pressed="{{ filter == 'all' ? 'true' : 'false' }}"
            hx-get="{{ reader_uri }}?action=list_addons&filter=all">{{ lang.btn_all }} <span class="chip-count">{{ count_all }}</span></button>
</div>

{% if addons is empty %}
    <div class="dash-empty-hint">{{ lang.msg_no_entries_found }}</div>
{% else %}
    <div class="dash-plugin-grid">
        {% for addon in addons %}
            <div class="dash-plugin-tile{{ addon.state == 'inactive' ? ' is-inactive' : '' }}">
                <span class="dash-plugin-mono" aria-hidden="true">{{ addon.initials }}</span>
                <a href="{{ addon.link }}" class="dash-min-w-0 flex-grow-1">
                    <span class="dash-row-title">{{ addon.name }}</span>
                    <span class="dash-row-meta">
                        {% if addon.state != 'none' %}<span class="dash-plugin-dot is-{{ addon.state }}"></span>{% endif %}
                        {% if addon.state != 'none' %}{{ addon.state == 'active' ? lang.status_active : lang.status_inactive }},{% endif %}
                        {{ addon.category }} {{ addon.version }}
                    </span>
                </a>
            </div>
        {% endfor %}
    </div>
{% endif %}
