{#
 # System information, rendered by the dashboard data-reader (action=list_infos)
 #}
<dl class="dash-info-list se-privacy-blur">
    <dt>Domain</dt>
    <dd>{{ se_settings.cms_domain }}</dd>
    <dt>SSL</dt>
    <dd>{{ se_settings.cms_ssl_domain ?: lang.status_inactive }}</dd>
    <dt>{{ lang.label_settings_mailer_name }}</dt>
    <dd>{{ se_settings.mailer_name }}</dd>
    <dt>{{ lang.label_settings_mailer_mail }}</dt>
    <dd>{{ se_settings.mailer_adr }}</dd>
    <dt>{{ lang.label_language }}</dt>
    <dd>{{ languages }}</dd>
    <dt>Server</dt>
    <dd>{{ global.server_name }}</dd>
    <dt>PHP</dt>
    <dd>{{ php_version }}</dd>
    <dt>{{ lang.nav_btn_database }}</dt>
    <dd>{{ database }}</dd>
</dl>
