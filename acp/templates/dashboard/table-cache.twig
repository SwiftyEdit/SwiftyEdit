{#
 # Caches, rendered by the dashboard data-reader (action=list_cache)
 #}
{% macro action_button(target, status_target, icon_html, label) %}
    <button hx-post="/admin-xhr/dashboard/write/"
            hx-vals='{"cache_target":"{{ target }}","csrf_token":"{{ csrf_token }}"}'
            hx-target="#cacheStatus_{{ status_target }}"
            hx-swap="innerHTML"
            hx-indicator=".htmx-indicator"
            class="btn btn-default btn-sm" title="{{ label }}">
        {{ icon_html|raw }}<span class="visually-hidden">{{ label }}</span>
    </button>
{% endmacro %}

{% import _self as m %}

{% for cache in caches %}
    <div class="dash-cache-row">
        <div class="dash-min-w-0 flex-grow-1">
            <div class="fw-semibold">{{ cache.label }}</div>
            <div class="d-flex align-items-center gap-2">
                <div class="progress dash-cache-bar flex-grow-1" role="presentation">
                    <div class="progress-bar" style="width: {{ cache.percent }}%"></div>
                </div>
                <small class="text-secondary text-nowrap">{{ cache.size }}</small>
            </div>
        </div>
        <span id="cacheStatus_{{ cache.target }}"></span>
        <div class="d-flex gap-1 flex-shrink-0">
            {% if cache.clear_only %}
                {{ m.action_button(cache.target, cache.target, icon.trash, lang.btn_delete_cache) }}
            {% elseif cache.clear_and_rebuild %}
                {{ m.action_button('products_clear', cache.target, icon.trash, lang.btn_delete_cache) }}
                {{ m.action_button('products_rebuild', cache.target, icon.arrow_clockwise, lang.cache_btn_rebuild) }}
            {% else %}
                {{ m.action_button(cache.target, cache.target, icon.arrow_clockwise, lang.cache_btn_rebuild) }}
            {% endif %}
        </div>
    </div>
{% endfor %}
