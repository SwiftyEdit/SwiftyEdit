<div class="list-group list-group-flush">
    {% for product in get_products %}
        <button type="submit" form="productsEditForm" class="list-group-item list-group-item-action" name="product_id" value="{{ product.id }}">
            <span class="dash-row-title">{{ product.title }}</span>
            <span class="dash-row-meta">{{ product.lastedit_formatted }}</span>
        </button>
    {% endfor %}
</div>
<form id="productsEditForm" action="/admin/shop/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
