{#
 # OPcache status, rendered by the dashboard data-reader (action=list_opcache).
 # The status pill sits in the static card header, so it is swapped out of band.
 #}
{% set is_on = opcache.available and opcache.enabled %}

<span id="opcachePill" hx-swap-oob="true" class="badge {{ is_on ? 'text-bg-success' : 'text-bg-secondary' }}">{{ is_on ? lang.status_active : lang.status_inactive }}</span>

{% if not opcache.available %}
    <p class="mb-0">{{ lang.opcache_status_unavailable }}</p>
{% elseif is_on %}
    <div class="d-flex justify-content-between gap-2 mb-1">
        <span class="fw-semibold">{{ lang.opcache_label_memory }}</span>
        <small class="text-secondary">{{ opcache.memory_used_mb }} / {{ (opcache.memory_used_mb + opcache.memory_free_mb + opcache.memory_wasted_mb)|round(1) }} MB ({{ opcache.memory_used_percent }}%)</small>
    </div>
    <div class="progress dash-cache-bar mb-3" role="presentation">
        <div class="progress-bar{{ opcache.cache_full ? ' bg-danger' : '' }}" style="width: {{ opcache.memory_used_percent }}%"></div>
    </div>

    <dl class="dash-info-list mb-0">
        <dt>{{ lang.opcache_label_hit_rate }}</dt>
        <dd>{{ opcache.hit_rate }}%</dd>
        <dt>{{ lang.opcache_label_cached_scripts }}</dt>
        <dd>{{ opcache.num_cached_scripts }} / {{ opcache.max_accelerated_files }}</dd>
        <dt>{{ lang.opcache_label_validate_timestamps }}</dt>
        <dd>{{ opcache.validate_timestamps ? lang.opcache_label_validate_timestamps_on : lang.opcache_label_validate_timestamps_off }}</dd>
        {% if opcache.start_time %}
            <dt>{{ lang.opcache_label_running_since }}</dt>
            <dd>{{ opcache.start_time|date('Y-m-d H:i') }}</dd>
        {% endif %}
    </dl>

    {% if opcache.cache_full %}
        <div class="alert alert-danger py-2 px-3 mt-2 mb-0">{{ lang.opcache_label_cache_full }}</div>
    {% endif %}

    {% if not opcache.validate_timestamps %}
        <div class="alert alert-warning py-2 px-3 mt-2 mb-0">{{ lang.opcache_hint_validate_timestamps_off }}</div>
    {% endif %}
{% else %}
    <p class="mb-0">{{ lang.opcache_status_unavailable }}</p>
{% endif %}
