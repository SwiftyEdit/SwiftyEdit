<div class="list-group list-group-flush">
    {% for user in get_user %}
        <button type="submit" form="usersEditForm" class="list-group-item list-group-item-action" name="user_id" value="{{ user.user_id }}">
            <span class="dash-row-title">{{ user.user_nick }}</span>
            <span class="dash-row-meta">{{ user.user_registerdate_formatted }}</span>
        </button>
    {% endfor %}
</div>
<form id="usersEditForm" action="/admin/users/edit/" method="post" class="d-none">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
</form>
