{#
 # installed themes in /admin/addons/, rendered by the addons data-reader
 # themes: list of {id, name, version, active, poster, layouts: list of {value, label, selected},
 #   stylesheets: list of {value, label, selected}, help_link (html), check_update, deletable}
 #}
{% for theme in themes %}
    <div class="card mb-3{% if theme.active %} border-success border-2 border-opacity-50{% endif %}">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                {{ theme.name }}
                {% if theme.version %}<span class="badge badge-se">{{ theme.version }}</span>{% endif %}
                {% if theme.active %}<span class="badge text-bg-success">{{ lang.status_active|capitalize }}</span>{% endif %}
            </div>
            {% if theme.check_update %}
                <div hx-get="{{ reader_uri }}?check_theme={{ theme.id|url_encode }}" hx-trigger="load"></div>
            {% endif %}
        </div>
        <div class="card-body">
            <div id="update-response-theme-{{ theme.id }}"></div>
            <div class="row">
                <div class="col-md-8">
                    <form hx-post="{{ writer_uri }}" hx-target="body" hx-swap="beforeend">
                        <input type="hidden" name="theme" value="{{ theme.id }}">
                        <div class="mb-2">
                            <label class="form-label" for="layout-{{ theme.id }}">{{ lang.addons_label_layout }}</label>
                            <select name="template_layout" id="layout-{{ theme.id }}" class="form-control">
                                {% for layout in theme.layouts %}
                                    <option value="{{ layout.value }}"{% if layout.selected %} selected{% endif %}>{{ layout.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        {# color variants of the theme (dist/skins/*.css), loaded in addition to its core stylesheet #}
                        <div class="mb-2">
                            <label class="form-label" for="stylesheet-{{ theme.id }}">{{ lang.addons_label_stylesheet }}</label>
                            <select name="template_stylesheet" id="stylesheet-{{ theme.id }}" class="form-control">
                                <option value="">{{ lang.label_default_template }}</option>
                                {% for stylesheet in theme.stylesheets %}
                                    <option value="{{ stylesheet.value }}"{% if stylesheet.selected %} selected{% endif %}>{{ stylesheet.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <hr>
                        <button type="submit" class="btn btn-success" name="save_default_layout" value="1">{{ lang.addons_btn_save_layout }}</button>
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    </form>
                </div>
                <div class="col-md-4">
                    <img src="{{ theme.poster }}" class="img-fluid rounded" alt="">
                    <a class="btn btn-default btn-sm mt-3 w-100" href="/admin/addons/theme/{{ theme.id }}/">{{ lang.btn_options }}</a>
                    {{ theme.help_link|raw }}
                    {# the default theme and the active theme can't be deleted,
                       pages still using the theme are checked in the data-writer #}
                    {% if theme.deletable %}
                        <button name="delete_theme" value="{{ theme.id }}" class="btn btn-default btn-sm text-danger mt-1 w-100" hx-post="{{ writer_uri }}" hx-confirm="{{ lang.msg_confirm_delete }}" hx-include="[name='csrf_token']" hx-target="body" hx-swap="beforeend">{{ icon.trash_alt|raw }} {{ lang.btn_delete }}</button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endfor %}
