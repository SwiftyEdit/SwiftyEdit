{#
 # catalog of installable plugins and themes in /admin/addons/catalog/, rendered by acp/core/addons/catalog.php
 # the grid is loaded by the addons data-reader (catalog-list.twig)
 #}
<div class="subHeader d-flex align-items-center">
    {{ icon.plugin|raw }} <a href="/admin/addons/">{{ lang.nav_btn_addons }}</a>
    <span class="ms-1">{{ lang.catalog_title }}</span>
</div>

{% if not enabled %}
    <div class="card p-3">{{ lang.catalog_disabled }}</div>
{% else %}
    {# the install buttons of the grid include this token #}
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div class="app-container">
        <div class="max-height-container">
            {# client-side only - plugins vs. themes come from the registry "type",
               the sub-categories of plugins (editor, payment) from the registry "tags" #}
            <div class="btn-group mb-3" data-catalog-filter>
                {% for tag, label in {'': lang.catalog_filter_all, '__plain__': lang.catalog_filter_plugins, '__theme__': lang.catalog_filter_themes, 'editor': lang.catalog_filter_editors, 'payment': lang.catalog_filter_payment} %}
                    <button type="button" class="btn btn-sm btn-default{% if tag == '' %} active{% endif %}" data-filter-tag="{{ tag }}">{{ label }}</button>
                {% endfor %}
            </div>

            {# .app-container is sized to the viewport by backend.js, so the grid needs its own .scroll-box #}
            <div class="scroll-box">
                <div id="catalogGrid" hx-get="{{ reader_uri }}?action=list_catalog" hx-trigger="load, refresh_catalog from:body">
                    <div class="d-flex align-items-center text-muted"><div class="spinner-border spinner-border-sm me-2" role="status"></div>{{ lang.loading }}</div>
                </div>
            </div>
        </div>
    </div>

    {# shared install modal of the grid, outside #catalogGrid so a refresh can't tear it down while it's open;
       the data-writer fills #catalogInstallModalBody with the confirm and result steps (install-confirm.twig) #}
    <div class="modal fade" id="catalogInstallModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="catalogInstallModalBody"></div>
        </div>
    </div>

    <script>
    (function () {
        var group = document.querySelector("[data-catalog-filter]");
        if (!group) { return; }

        group.addEventListener("click", function (e) {
            var btn = e.target.closest("[data-filter-tag]");
            if (!btn) { return; }

            group.querySelectorAll("[data-filter-tag]").forEach(function (b) {
                b.classList.toggle("active", b === btn);
            });

            var tag = btn.getAttribute("data-filter-tag");
            document.querySelectorAll("#catalogGrid [data-catalog-tags]").forEach(function (card) {
                var tags = card.getAttribute("data-catalog-tags").split(",").filter(Boolean);
                var isTheme = card.getAttribute("data-catalog-type") === "theme";
                var show;
                if (tag === "") {
                    show = true;
                } else if (tag === "__theme__") {
                    show = isTheme;
                } else if (tag === "__plain__") {
                    show = !isTheme && tags.indexOf("editor") === -1 && tags.indexOf("payment") === -1;
                } else {
                    show = !isTheme && tags.indexOf(tag) !== -1;
                }
                card.style.display = show ? "" : "none";
            });
        });
    })();
    </script>
{% endif %}
