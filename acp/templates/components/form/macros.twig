{#
 # form macros shared by the edit forms (products, blog, events)
 # {% import 'components/form/macros.twig' as form %}
 #}

{# options: list of {value, label, selected} #}
{% macro select(name, options, id = null, class = 'form-control custom-select') %}
    <select name="{{ name }}" class="{{ class }}"{% if id %} id="{{ id }}"{% endif %}>
        {% for option in options %}
            <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
        {% endfor %}
    </select>
{% endmacro %}

{# categories: list of {id, hash, name, description, flag, checked}, see se_get_category_checklist() #}
{% macro categories(name, categories) %}
    {# the whole row is the toggle - the checkbox stays for the form and the keyboard, but is hidden #}
    <div class="list-group">
        {% for category in categories %}
            <label class="list-group-item list-group-item-action category-pick">
                <input class="visually-hidden" type="checkbox" id="cat{{ category.id }}" name="{{ name }}" value="{{ category.hash }}"{% if category.checked %} checked{% endif %}>
                <span>
                    <strong>#{{ category.id }} {{ category.name }}</strong><small class="d-block opacity-75"><img src="{{ category.flag }}" width="16"> {{ category.description }}</small>
                </span>
            </label>
        {% endfor %}
    </div>
{% endmacro %}

{# selected images (picker_0) and the image-select widget, used by blog and events
   images: list of {path, src, name} #}
{% macro images(images) %}
    <label class="form-label">{{ lang.label_image }}</label>
    <div class="images-list">
        {% import _self as m %}
        {{ m.image_dropzone(images, 0) }}
        <div id="imgWidget" hx-post="/admin-xhr/widgets/read/?widget=img-select" hx-include="[name='csrf_token']" hx-trigger="load, update_image_widget from:body">Loading Images ...</div>
    </div>
{% endmacro %}

{# drop zone of the image picker, the selected images are sent as picker_<index>[] (see backend.js) #}
{% macro image_dropzone(images, picker_index) %}
    <div id="imgdropper" class="sortable_target image-dropzone mb-3" data-picker-index="{{ picker_index }}" data-drop-hint="{{ lang.drop_images_here|default('Drop images here') }}">
        {% for image in images %}
            <div class="picker-item draggable" data-id="{{ image.path }}" title="{{ image.path }}">
                <img class="picker-thumb" src="{{ image.src }}" alt="" loading="lazy">
                <div class="picker-text">
                    <div class="picker-name">{{ image.name }}</div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}

{# labels: list of {id, color, title, checked}, see se_get_label_checklist() #}
{% macro labels(name, labels) %}
    <div class="label-chips">
        {% for label in labels %}
            <input class="btn-check" id="label{{ label.id }}" type="checkbox" autocomplete="off"{% if label.checked %} checked{% endif %} name="{{ name }}" value="{{ label.id }}">
            <label class="label-chip" for="label{{ label.id }}" style="--label-color: {{ label.color }}"><span class="label-chip-dot"></span>{{ label.title }}</label>
        {% endfor %}
    </div>
{% endmacro %}
