{# group of radios, rendered by tpl_form_radios() - radios: list of {id, value, label, checked}, raw like input-text.twig #}
{% for radio in radios %}
    <div class="form-check">
        <input class="form-check-input" type="radio" name="{{ input_name|raw }}" value="{{ radio.value|raw }}" id="{{ radio.id }}"{% if radio.checked %} checked{% endif %}>
        <label class="form-check-label" for="{{ radio.id }}">{{ radio.label|raw }}</label>
    </div>
{% endfor %}
