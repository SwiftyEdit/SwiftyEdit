{# API keys in /admin/settings/api-keys/, rendered by acp/core/settings/api-keys.php #}
{% extends 'layout/settings-page.twig' %}

{% block content %}
    {% embed 'components/settings/section.twig' with {help: help['api-keys-list'], title: lang.api_keys_nav} %}
        {% block fields %}
            {# the plaintext key of a newly created key is shown here, exactly once #}
            <div id="apiKeyCreated"></div>
            <div id="getApiKeys" hx-get="{{ reader_uri }}?load_api_keys=1" hx-trigger="load, updated_api_keys from:body">
                <span class="sr-only">Loading...</span>
            </div>
        {% endblock %}
    {% endembed %}

    {% embed 'components/settings/section.twig' with {help: help['api-keys-new'], title: lang.api_keys_btn_create} %}
        {% block fields %}
            {# api-key-created (writer) resets the form, only on success #}
            <form hx-post="{{ writer_uri }}" hx-target="#apiKeyCreated" hx-on:api-key-created="this.reset()">
                <div class="mb-3">
                    <label class="form-label" for="api_key_label">{{ lang.api_keys_label }}</label>
                    <input class="form-control" type="text" id="api_key_label" name="api_key_label" value="" maxlength="255" required>
                </div>
                <div class="mb-3">
                    <div class="form-label">{{ lang.api_keys_scopes }}</div>
                    {% for scope in scopes %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="api_key_scopes[]" value="{{ scope.value }}" id="{{ scope.id }}">
                            <label class="form-check-label" for="{{ scope.id }}">{{ scope.label }} <code>{{ scope.value }}</code></label>
                        </div>
                    {% endfor %}
                </div>
                <div class="d-flex justify-content-end">
                    <button type="submit" name="create_api_key" value="new" class="btn btn-primary">{{ lang.api_keys_btn_create }}</button>
                </div>
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            </form>
        {% endblock %}
    {% endembed %}
{% endblock %}
